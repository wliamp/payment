namespace org.hamsaqua.event.payment.authorize.v1.fraud.result;

schema EventType;

enum EventType {
	FRAUD_RESULT
}

enum FraudAction {
	NONE,
	REVIEW,
	BLOCK
}

record FraudResultV1 {
	EventType eventType;
	@logicalType("uuid") string transactionId;
	@logicalType("uuid") string correlationId;
	int riskScore;
	FraudAction action;
	@logicalType("timestamp-millis") long timestamp;
}
