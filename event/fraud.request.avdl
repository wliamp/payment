namespace package;

schema EventType;

enum EventType {
	FRAUD_REQUESTED
}

record FraudRequestV1 {
	EventType eventType;
	@logicalType("uuid") string transactionId;
	@logicalType("uuid") string correlationId;
	string merchantId;
	string payerId;
	double amount;
	string currency;
	@logicalType("timestamp-millis") long timestamp;
}
